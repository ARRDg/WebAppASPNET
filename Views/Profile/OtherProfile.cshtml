@using WebAppASPNET.Services.Implementations
@model WebAppASPNET.Models.ProfileModel
@{
    ViewData["Title"] = $"Профиль {Model.CurrentName}";
    var friendshipStatus = (FriendshipStatusInfo)ViewBag.FriendshipStatus;
    var profileUserId = Model.CurrentId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h1>Имя пользователя:</h1>
    <h2>@Model.CurrentName</h2>
    <h1>Email:</h1>
    <h2>@Model.CurrentEmail</h2>

    <div class="mt-3">

        @if (friendshipStatus == FriendshipStatusInfo.None)
        {
            <form asp-controller="Friendship" asp-action="SendFriendRequest" asp-route-id="@profileUserId" method="post">
                <button type="submit" class="btn btn-primary">Добавить в друзья</button>
            </form>
        }
        else if (friendshipStatus == FriendshipStatusInfo.RequestSent)
        {
            <form asp-controller="Friendship" asp-action="CancelFriendRequest" asp-route-id="@profileUserId" method="post">
                <button type="submit" class="btn btn-warning">Отменить запрос</button>
            </form>
        }
        else if (friendshipStatus == FriendshipStatusInfo.RequestReceived)
        {
            <div class="d-flex gap-2">
                <form asp-controller="Friendship" asp-action="AcceptFriendRequest" asp-route-id="@profileUserId" method="post">
                    <button type="submit" class="btn btn-success">Принять запрос</button>
                </form>
                <form asp-controller="Friendship" asp-action="DeclineFriendRequest" asp-route-id="@profileUserId" method="post">
                    <button type="submit" class="btn btn-danger">Отклонить запрос</button>
                </form>
            </div>
        }
        else if (friendshipStatus == FriendshipStatusInfo.Friends)
        {
            <form asp-controller="Friendship" asp-action="RemoveFriend" asp-route-id="@profileUserId" method="post">
                <button type="submit" class="btn btn-danger">Удалить из друзей</button>
            </form>
        }
    </div>
</div>