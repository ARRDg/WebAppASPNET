@model ProfileModel
@{
    ViewData["Title"] = $"{Model.CurrentName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}
<h1>Ваше имя:</h1>
<h2>@Model.CurrentName</h2>
<h1>Ваше почта:</h1>
<h2>@Model.CurrentEmail</h2>
<a class="btn btn-primary" asp-controller="Friendship" asp-action="SendFriendRequest" asp-route-id="@Model.CurrentId">Добавить в др</a>
<a class="btn btn-primary" asp-controller="Friendship" asp-action="AcceptFriendRequest" asp-route-id="@Model.CurrentId">Принять запрос</a>
<a class="btn btn-primary" asp-controller="Friendship" asp-action="DeclineFriendRequest" asp-route-id="@Model.CurrentId">Отклонить запрос</a>